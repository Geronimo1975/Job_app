        "documentId": { "__rl": true, "mode": "id", "value": "1p0u4XcMxOWex2-OTfIxnvpun3NVFkrqh3DvLWhRBkO0" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Job Applications" },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["URL"]
        },
        "options": {}
      },
      "id": "gs-upsert",
